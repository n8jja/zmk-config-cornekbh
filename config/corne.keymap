#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>; /* tune to taste */
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp EXCLAMATION>;
            key-positions = <1 13>;
        };

        at-sign {
            bindings = <&kp AT_SIGN>;
            key-positions = <2 14>;
        };

        hash {
            bindings = <&kp HASH>;
            key-positions = <3 15>;
            layers = <0>;
        };

        dollar {
            bindings = <&kp EQUAL>;
            key-positions = <4 16>;
            layers = <0>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <4 16>;
            layers = <0>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <5 17>;
            layers = <0>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <13 25>;
            layers = <0>;
        };

        ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <26 14>;
            layers = <0>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <27 15>;
            layers = <0>;
        };

        left-par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 28>;
            layers = <0>;
        };

        right-par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <17 29>;
            layers = <0>;
        };

        minus {
            bindings = <&kp KP_MINUS>;
            key-positions = <19 7>;
            layers = <0>;
        };

        scroll-up {
            bindings = <&kp K_SCROLL_UP>;
            key-positions = <6 18>;
            layers = <0>;
        };

        left-brack {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 19>;
            layers = <0>;
        };

        right-brack {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <32 20>;
            layers = <0>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <20 8>;
            layers = <0>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <21 9>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <21 33>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <19 20>;
        };

        layer-3 {
            bindings = <&mo 3>;
            key-positions = <6 7>;
        };

        layer-4 {
            bindings = <&mo 4>;
            key-positions = <18 19>;
        };

        layer-1 {
            bindings = <&mo 1>;
            key-positions = <5 4>;
        };

        layer-2 {
            bindings = <&mo 2>;
            key-positions = <17 16>;
        };

        up {
            bindings = <&kp UP_ARROW>;
            key-positions = <2 3>;
        };

        left {
            bindings = <&kp LEFT>;
            key-positions = <14 13>;
        };

        down {
            bindings = <&kp DOWN>;
            key-positions = <14 15>;
        };

        right {
            bindings = <&kp RIGHT>;
            key-positions = <15 16>;
        };
    };

    //

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&kp ESCAPE      &kp Q  &kp W  &kp F             &kp P         &kp G        &kp J      &kp L          &kp U          &kp Y    &kp SEMICOLON  &kp MINUS
&kp TAB         &kp A  &kp R  &kp S             &kp T         &kp D        &kp H      &kp N          &kp E          &kp I    &kp O          &kp BACKSLASH
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C             &kp V         &kp B        &kp K      &kp M          &kp COMMA      &kp DOT  &kp FSLH       &kp SQT
                              &kp LEFT_CONTROL  &kp LEFT_GUI  &kp ENTER    &kp SPACE  &kp BACKSPACE  &kp RIGHT_GUI
            >;
        };

        NUM {
            display-name = "Numbers";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&trans  &none  &none  &none   &none   &none     &kp PLUS      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL  &none
&trans  &none  &none  &none   &none   &none     &kp ASTERISK  &kp N4        &kp N5        &kp N6        &kp N0     &none
&trans  &none  &none  &none   &none   &none     &kp MINUS     &kp N7        &kp N8        &kp N9        &kp SLASH  &none
                      &trans  &trans  &trans    &trans        &trans        &trans
            >;
        };

        NAV {
            display-name = "Navigation";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &none  &none  &none   &none   &none     &none   &kp LC(NUMBER_1)  &kp LC(NUMBER_2)  &kp LC(NUMBER_3)  &kp LC(NUMBER_4)  &none
&trans  &none  &none  &none   &none   &none     &none   &kp LA(LS(TAB))   &kp LG(LS(TAB))   &kp LG(TAB)       &kp LG(W)         &kp LG(LC(F))
&trans  &none  &none  &none   &none   &none     &none   &none             &none             &none             &none             &none
                      &trans  &trans  &trans    &trans  &trans            &trans
            >;
        };

        MMD {
            display-name = "Multimedia";
            bindings = <
&trans  &kp LG(LS(M))  &kp K_PREVIOUS  &kp K_PLAY_PAUSE  &kp K_NEXT  &none         &none   &none   &none   &none  &none        &none
&trans  &kp F11        &kp F12         &trans            &trans      &none         &none   &none   &none   &none  &none        &none
&trans  &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2      &bt BT_CLR  &bt BT_CLR    &none   &none   &none   &none  &bootloader  &none
                                       &trans            &trans      &trans        &trans  &trans  &trans
            >;
        };

        EXTRA {
            display-name = "Extra";
            bindings = <
&trans  &trans  &trans          &trans          &trans           &msc SCRL_UP      &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans          &mmv MOVE_UP    &trans           &msc SCRL_DOWN    &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans            &trans  &trans     &trans     &trans  &trans  &trans
                                &trans          &trans           &trans            &trans  &trans     &trans
            >;
        };
    };
};
